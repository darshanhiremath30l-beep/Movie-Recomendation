# =======================================================
# MongoDB Configuration
# =======================================================
# Leave MONGO_URI blank to run with local offline storage (local_db.json).
# To connect a new MongoDB database:
# 1. Create a free cluster at https://cloud.mongodb.com/
# 2. Add an IP Access entry (0.0.0.0/0) under Network Access
# 3. Create a Database User under Database Access
# 4. Copy your connection string and paste it below:
# Example: MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DBNAME=cinematch_db

# Flask Configuration
SECRET_KEY=cinematch-secret-key-development
FLASK_ENV=development
